{
  "name": "clairmd-backend",
  "version": "0.1.0",
  "description": "ClairMD Clinic platform backend — doctor accounts, billing, referral routing, and backup telemetry ONLY. Patient data is never stored here (see README).",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "erase-deactivated": "node src/db/eraseDeactivatedAccounts.js",
    "nightly-overage-billing": "node src/db/runNightlyOverageBilling.js",
    "create-admin": "node src/db/createAdminAccount.js",
    "test": "node --test src/**/*.test.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "googleapis": "^140.0.1",
    "dotenv": "^16.4.5",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.4.0",
    "zod": "^3.23.8",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "firebase-admin": "^12.3.1",
    "nodemailer": "^6.9.14"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
