# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database (platform metadata only — see schema.sql header) ---
DATABASE_URL=postgres://clairmd_user:changeme@localhost:5432/clairmd_platform

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string-before-any-real-deployment
JWT_EXPIRES_IN=7d

# --- Secrets-at-rest encryption key, used to encrypt stored Google OAuth
# refresh tokens before they're written to the database. 32 bytes, base64.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_ENCRYPTION_KEY=replace-with-generated-32-byte-base64-key

# --- Google OAuth (for the doctor-owned Drive backup connection) ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/drive/oauth/callback

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- CORS — the origin(s) allowed to call this API in production. Left
# unset, cross-origin requests are blocked once NODE_ENV=production
# (server.js falls back to no allowed origin rather than allowing all, for
# safety) — set this before deploying, not after something breaks.
CORS_ORIGIN=https://app.clairmd.net

# --- License verification — see services/licenseVerification.js for the
# researched options and why none are wired up by default. Set this once
# a real provider (a commercial API, or a properly tested NMC
# integration) is actually chosen and implemented.
LICENSE_VERIFICATION_PROVIDER=unconfigured

# --- Razorpay payment webhook. The secret configured in your Razorpay
# dashboard's webhook settings — used to verify incoming webhook calls
# actually came from Razorpay (see routes/billing.js's /webhook route).
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# --- Push notifications (Firebase Cloud Messaging). The full service
# account JSON from Firebase console, as a single-line string.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# --- Email notification fallback (used when push isn't available/fails).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=notifications@clairmd.net

# --- Permanent account erasure retention period, in days. PLACEHOLDER —
# not a legal recommendation, see db/eraseDeactivatedAccounts.js's header
# comment before relying on this number for anything but local testing.
DATA_RETENTION_DAYS=365
